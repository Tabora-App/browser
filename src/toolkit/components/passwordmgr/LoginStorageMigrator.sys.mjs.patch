+  /**
+   * Tabora: полностью удалить копии паролей под ключом NSS — logins.json, logins-backup.json,
+   * их .corrupt- и .tmp-файлы и данные JSON-хранилища в памяти (без надгробий). verify:
+   * сначала убедиться, что каждая запись JSON есть в Rust-хранилище под ключом сейфа, и
+   * перенести недостающие; если перенести не удалось, копии остаются до следующего запуска.
+   */
+  async #taboraPurgeJson({ verify = false } = {}) {
+    const dir = PathUtils.profileDir;
+    const pattern =
+      /^logins(-backup)?\.json(\.tmp|(-\d+)?\.corrupt)?$/;
+    const files = (await IOUtils.getChildren(dir)).filter(p =>
+      pattern.test(PathUtils.filename(p))
+    );
+    const store = this.#jsonStorage._store;
+    const logins = store?.dataReady ? store.data.logins || [] : [];
+    if (!files.length && !logins.length) {
+      return;
+    }
+    const live = logins.filter(l => !l.deleted);
+    if (verify && live.length) {
+      if (!this.#rustStorage.taboraVaultKeyed) {
+        return; // пароли этой сессии под NSS: проверим при следующем запуске
+      }
+      const missing = new Set();
+      for (const login of live) {
+        const found = await this.#rustStorage.searchLoginsAsync({
+          guid: login.guid,
+        });
+        if (!found.length) {
+          missing.add(login.guid);
+        }
+      }
+      if (missing.size) {
+        if (
+          lazy.LoginHelper.isPrimaryPasswordSet() &&
+          !this.#jsonStorage.isLoggedIn
+        ) {
+          return; // основной пароль Firefox при запуске не спрашиваем
+        }
+        const toAdd = (await this.#jsonStorage.getAllLogins(false)).filter(l =>
+          missing.has(l.QueryInterface(Ci.nsILoginMetaInfo).guid)
+        );
+        if (toAdd.length !== missing.size) {
+          return;
+        }
+        const results =
+          await this.#rustStorage.addLoginsWithResultsAsync(toAdd);
+        if (
+          results.some(
+            r => r.error && !/Login already exists/i.test(r.error.message)
+          )
+        ) {
+          this.#logger.log("Tabora: some JSON logins still not migrated");
+          return;
+        }
+      }
+    }
+    if (store) {
+      await this.#jsonStorage.removeAllUserFacingLoginsAsync(true);
+      store.data.logins = [];
+      store.data.potentiallyVulnerablePasswords = [];
+      // запись пустого logins.json не нужна: файлы удаляем ниже
+      store._saver?.disarm();
+    }
+    for (const path of files) {
+      await IOUtils.remove(path, { ignoreAbsent: true });
+    }
+    this.#logger.log(`Tabora: removed ${files.length} NSS-encrypted login files`);
+  }
