index 3413154..562cb2e 100644
--- a/firefox-ios/Client/Application/AppLaunchUtil.swift
+++ b/firefox-ios/Client/Application/AppLaunchUtil.swift
@@ -46,6 +46,31 @@ final class AppLaunchUtil: FeatureFlaggable, Sendable {
             AppleIntelligenceUtil().processAvailabilityState()
         }
 
+        // Tabora: ничего не отправляется в Mozilla. Настройки отправки данных, отчётов о сбоях и
+        // участия в исследованиях читаются в десятке мест со значением «включено», если настройки
+        // ещё нет, — поэтому при первом запуске они записываются выключенными.
+        let taboraDefaults = NSUserDefaultsPrefs(prefix: "profile")
+        for key in [AppConstants.prefSendUsageData, AppConstants.prefSendCrashReports,
+                    AppConstants.prefSendDailyUsagePing, AppConstants.prefStudiesToggle,
+                    AppConstants.prefRolloutsToggle] where taboraDefaults.boolForKey(key) == nil {
+            taboraDefaults.setBool(false, forKey: key)
+        }
+        // Tabora: блокировка рекламы включена с первого запуска (в Firefox её включают вручную);
+        // выключается в «Настройки → Просмотр сайтов»
+        if taboraDefaults.boolForKey(PrefsKeys.BlockAds) == nil {
+            taboraDefaults.setBool(true, forKey: PrefsKeys.BlockAds)
+        }
+        // Tabora: плашки «сделать браузером по умолчанию» в меню нет, пока Apple не выдала приложению
+        // это право: без него такого выбора в настройках системы не существует
+        if taboraDefaults.boolForKey(PrefsKeys.defaultBrowserBannerShown) == nil {
+            taboraDefaults.setBool(true, forKey: PrefsKeys.defaultBrowserBannerShown)
+        }
+        // Tabora: защита от отслеживания с первого запуска строгая — блокируются и сами счётчики,
+        // а не только их cookies (как в Tabora для компьютера). Режим меняется в настройках.
+        if taboraDefaults.stringForKey(ContentBlockingConfig.Prefs.StrengthKey) == nil {
+            taboraDefaults.setString(BlockingStrength.strict.rawValue, forKey: ContentBlockingConfig.Prefs.StrengthKey)
+        }
+
         // Need to get "settings.sendCrashReports" this way so that Sentry can be initialized before getting the Profile.
         let sendCrashReports = NSUserDefaultsPrefs(prefix: "profile").boolForKey(AppConstants.prefSendCrashReports) ?? true
 
