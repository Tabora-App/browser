+# Tabora: Apple Developer Team ID of the certificate the application is signed
+# with (macTeamId in browser.json). The privileged update helper and the
+# application authorize each other by this ID, so it must not be Mozilla's.
+option(
+    env="TABORA_MAC_TEAM_ID",
+    nargs=1,
+    when=target_is_osx,
+    help="Apple Developer Team ID used in code signing requirements",
+)
+
+
+@depends("TABORA_MAC_TEAM_ID", when=target_is_osx)
+@imports("re")
+def mac_team_id(value):
+    if not value:
+        die("TABORA_MAC_TEAM_ID is not set: configure through tools/build.py")
+    team_id = value[0]
+    if not re.match(r"^[A-Z0-9]{10}$", team_id):
+        die("TABORA_MAC_TEAM_ID must be a 10 character Team ID, got %s", team_id)
+    if team_id == "43AQ936H96":
+        die("TABORA_MAC_TEAM_ID must not be the Team ID of Mozilla")
+    return team_id
+
+
+def mac_prod_requirements_string(identifier, team_id):
     return (
         f'identifier "{identifier}" and anchor apple generic and '
         "certificate 1[field.1.2.840.113635.100.6.2.6] and "
         "certificate leaf[field.1.2.840.113635.100.6.1.13] and "
-        'certificate leaf[subject.OU] = "43AQ936H96"'
+        f'certificate leaf[subject.OU] = "{team_id}"'
     )
 
 
