<!-- Надписи Tabora, которых нет в Firefox. Перевод — в values-ru/tabora_strings.xml. -->
<resources>
    <string name="pref_key_tabora_shield" translatable="false">pref_key_tabora_shield</string>
    <!-- Settings switch: built-in ad blocker -->
    <string name="preferences_tabora_shield">Block ads</string>
    <string name="preferences_tabora_shield_summary">Hides ads and trackers on pages. Filter lists update on their own.</string>
    <string name="pref_key_tabora_account" translatable="false">pref_key_tabora_account</string>
    <!-- Экран и пункт настроек: вход в аккаунт Tabora и синхронизация -->
    <string name="tabora_account_title">Tabora account</string>
    <string name="tabora_account_summary">Sign in to share tabs between your devices</string>
    <!-- Список вкладок, страница вкладок других устройств -->
    <string name="tabora_synced_tabs_off">Tab sync is turned off on this phone. Turn it on in your Tabora account.</string>
    <string name="tabora_synced_tabs_empty">No tabs from your other devices yet. They will appear once you open Tabora on another device and sign in to this account there.</string>
    <string name="tabora_synced_tabs_signed_out_title">Tabs from your other devices</string>
    <string name="tabora_synced_tabs_signed_out_text">Sign in to your Tabora account to see tabs from your computer and other devices here.</string>
    <string name="tabora_synced_tabs_sign_in">Sign in</string>
    <string name="pref_key_tabora_codes" translatable="false">pref_key_tabora_codes</string>
    <!-- Коды входа (второй шаг на сайтах): экран, пункт меню и настроек, запрос отпечатка -->
    <string name="tabora_codes_title">Sign-in codes</string>
    <string name="tabora_codes_summary">Two-step codes for websites, shared with your other devices</string>
    <string name="tabora_codes_auth_title">Unlock sign-in codes</string>
    <string name="tabora_codes_auth_text">Confirm it’s you to see and fill codes</string>
    <plurals name="tabora_codes_count">
        <item quantity="one">%d code</item>
        <item quantity="other">%d codes</item>
    </plurals>
    <!-- Экран и пункт меню: почта аккаунта внутри приложения -->
    <string name="tabora_mail_title">Tabora Mail</string>
    <!-- Sign in with a QR code shown by another device: scanner hint -->
    <string name="tabora_pair_scan_hint">Point the camera at the QR code on your computer screen</string>
    <!-- Spaces: the one every device has -->
    <string name="tabora_space_personal">Personal</string>
    <!-- Spaces: creating, editing and deleting a space in the tab manager -->
    <string name="tabora_space_add">New space</string>
    <string name="tabora_space_edit_title">Space</string>
    <string name="tabora_space_name">Name</string>
    <string name="tabora_space_save">Save</string>
    <string name="tabora_space_cancel">Cancel</string>
    <string name="tabora_space_edit">Edit</string>
    <string name="tabora_space_move_left">Move left</string>
    <string name="tabora_space_move_right">Move right</string>
    <string name="tabora_space_delete">Delete</string>
    <string name="tabora_space_delete_title">Delete the space “%1$s”?</string>
    <string name="tabora_space_delete_text">Sign-ins on sites in this space will be erased from the phone.</string>
    <plurals name="tabora_space_delete_tabs">
        <item quantity="one">Its %1$d tab will be closed, and sign-ins on sites in this space will be erased from the phone.</item>
        <item quantity="other">Its %1$d tabs will be closed, and sign-ins on sites in this space will be erased from the phone.</item>
    </plurals>
    <!-- Spaces: the badge next to the address and the link menu item -->
    <string name="tabora_space_badge">Space “%1$s”</string>
    <string name="tabora_space_open_link">Open in the space “%1$s”</string>
    <!-- "Send to device": a page another device of the account sent to this phone has been opened. %1$s is the device's name -->
    <string name="tabora_sent_tab_opened">Opened a tab from “%1$s”</string>
    <string name="tabora_sent_tab_opened_unnamed">Opened a tab from another device</string>
</resources>
