# Модули Tabora для Android. Каталог browser/ на Android не собирается, поэтому то, что нужно
# самому движку (блокировщик рекламы), регистрируется здесь под теми же адресами
# chrome://tabora/content/…, что и на компьютере (browser/base/jar.mn). Исходники — одни и те же
# файлы: путь с ведущей косой чертой отсчитывается от корня исходников.
geckoview.jar:
% content tabora %content/tabora/
    content/tabora/shield/Shield.sys.mjs               (/browser/base/content/tabora/shield/Shield.sys.mjs)
    content/tabora/shield/ShieldEngine.sys.mjs         (/browser/base/content/tabora/shield/ShieldEngine.sys.mjs)
    content/tabora/actors/TaboraShieldParent.sys.mjs   (/browser/base/content/tabora/actors/TaboraShieldParent.sys.mjs)
    content/tabora/actors/TaboraShieldChild.sys.mjs    (/browser/base/content/tabora/actors/TaboraShieldChild.sys.mjs)
# языки надписей: модули блокировщика берут тег перевода отсюда
    content/tabora/i18n/I18n.sys.mjs                   (/browser/base/content/tabora/i18n/I18n.sys.mjs)
    content/tabora/i18n/en.json                        (/browser/base/content/tabora/i18n/en.json)
    content/tabora/i18n/uk.json                        (/browser/base/content/tabora/i18n/uk.json)
    content/tabora/i18n/es.json                        (/browser/base/content/tabora/i18n/es.json)
