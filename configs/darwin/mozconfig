# macOS. Цель (--target) подставляет tools/build.py.

unset MOZ_STDCXX_COMPAT

ac_add_options --disable-dmd
ac_add_options --enable-eme=widevine

# Кросс-сборка macOS на Linux-машине: тулчейн Mozilla лежит в ~/mac-cross
if test "$BROWSER_CROSS_COMPILING"; then
  MAC_CROSS="$HOME/mac-cross"
  mk_add_options "export PATH=$MAC_CROSS/cctools/bin:$PATH"
  mk_add_options "export LD_LIBRARY_PATH=$HOME/.mozbuild/clang/lib:$LD_LIBRARY_PATH"
  export MKFSHFS=$MAC_CROSS/hfsplus/newfs_hfs
  export DMG_TOOL=$MAC_CROSS/dmg/dmg
  export HFS_TOOL=$MAC_CROSS/dmg/hfsplus
  if test "$BROWSER_RELEASE"; then
    export MOZ_LD64_KNOWN_GOOD=1
    ac_add_options --enable-linker=ld64
  fi
fi

if test "$TARGET_ARCH" = "aarch64" && test "$BROWSER_RELEASE"; then
  export CFLAGS="$CFLAGS -mcpu=apple-m1"
  export CXXFLAGS="$CXXFLAGS -mcpu=apple-m1"
fi
