#
# Общие настройки сборки. Имя приложения, бренд, цель и версия подставляются
# инструментом tools/build.py в заголовок mozconfig.

ac_add_options --enable-application=browser

# Локальная сборка на ноутбуке: не забирать все ядра и память (в CI переменная CI задана)
if test -z "$CI"; then
  mk_add_options MOZ_PARALLEL_BUILD=8
fi
# --with-l10n-base (переводы firefox-l10n в .build/l10n-central) задаёт tools/build.py

if test "$SCCACHE_GHA_ENABLED" = "true"; then
  if test -x "$(command -v sccache)"; then
    ac_add_options --with-ccache=sccache
  elif test -f "$HOME/.mozbuild/sccache/sccache"; then
    ac_add_options --with-ccache="$HOME"/.mozbuild/sccache/sccache
  fi
  mk_add_options 'export RUSTC_WRAPPER=sccache'
  mk_add_options 'export CCACHE_CPP2=yes'
fi

# BROWSER_RELEASE=1 — сборка для распространения: MOZILLA_OFFICIAL (без удалённой отладки и
# инструментов разработчика браузера по умолчанию), оптимизации, без тестов. Пакет без этого
# режима tools/build.py помечает «-dev», а tools/sign_macos.sh подписывает только с --dev.
if test "$BROWSER_RELEASE"; then
  ac_add_options --enable-optimize
  ac_add_options --enable-release
  ac_add_options --disable-debug
  ac_add_options --disable-debug-symbols
  ac_add_options --disable-debug-js-modules
  ac_add_options --disable-tests
  ac_add_options --enable-rust-simd
  ac_add_options --disable-geckodriver
  ac_add_options --disable-rust-tests

  # configure сам скачивает недостающие тулчейны Mozilla (clang, SDK, cctools)
  if ! test "$BROWSER_DISABLE_BOOTSTRAP"; then
    ac_add_options --enable-bootstrap=-sccache
  fi

  # LTO: отключаемо, чтобы первая сборка шла быстрее и требовала меньше памяти
  if test "$BROWSER_DISABLE_LTO"; then
    ac_add_options --disable-lto
  else
    export MOZ_LTO=cross,thin
    ac_add_options --enable-lto=cross,thin
  fi

  mk_add_options MOZILLA_OFFICIAL=1
  MOZILLA_OFFICIAL=1
  export MOZILLA_OFFICIAL=1
  mk_add_options AUTOCLOBBER=1
  export AUTOCLOBBER=1
fi

# Подпись дополнений обязательна (MOZ_REQUIRE_SIGNING по умолчанию для релизной ветки):
# неподписанные расширения не ставятся ни в профиль, ни из системных каталогов.
# Русский интерфейс встроен в сборку (mach package-multi-locale, tools/build.py package),
# а не неподписанным языковым пакетом, поэтому снимать требование не нужно.

# Google Safe Browsing: ключ из файла вне репозитория (docs/UPDATES.md, раздел «Safe Browsing»).
# Без ключа провайдеры Google не работают: фишинг и вредоносные загрузки не проверяются, а
# tools/build.py выключает удалённую проверку загрузок (browser.safebrowsing.downloads.remote.enabled),
# чтобы сведения о файлах не уходили в Google с ключом-заглушкой. Условие наличия ключа там то же.
_tabora_sb_key="${TABORA_SAFEBROWSING_KEYFILE:-$HOME/.config/tabora/safebrowsing.key}"
# Здесь нельзя ничего печатать (echo): mach разбирает вывод mozconfig и падает на посторонних
# строках. Об отсутствии ключа в релизной сборке предупреждает tools/build.py.
if test -s "$_tabora_sb_key"; then
  ac_add_options --with-google-safebrowsing-api-keyfile="$_tabora_sb_key"
fi
unset _tabora_sb_key

# Отчёты о сбоях и телеметрия Mozilla выключены сборкой в любой конфигурации, не только релизной
# (проверяет tools/build.py: MOZ_CRASHREPORTER, MOZ_TELEMETRY_REPORTING, MOZ_DATA_REPORTING в пакете):
# - --disable-crashreporter: нет crashreporter.app, нет [Crash Reporter] ServerURL в application.ini;
# - MOZ_TELEMETRY_REPORTING= — настоящая опция configure (toolkit/moz.configure), без неё в сборке
#   с MOZILLA_OFFICIAL телеметрия включается;
# - MOZ_SERVICES_HEALTHREPORT и MOZ_NORMANDY из mozconfig не задаются (project_flag): они убраны
#   патчем src/browser/moz.configure.patch, после чего MOZ_DATA_REPORTING не определяется;
# - выгрузка Glean: src/toolkit/library/rust/gkrust-features.mozbuild.patch (glean_disable_upload всегда).
ac_add_options --disable-crashreporter
ac_add_options MOZ_TELEMETRY_REPORTING=

# Канал пакетов обновления: MAR с другим идентификатором обновлятор отвергнет
export MAR_CHANNEL_ID=tabora-release
export ACCEPTED_MAR_CHANNEL_IDS=tabora-release
