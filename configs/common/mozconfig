# Бренд и имя приложения (подставляет Surfer из surfer.json)
ac_add_options --with-app-name=${binName}
ac_add_options --with-app-basename=Browser

ac_add_options --with-l10n-base="${topsrcdir}/browser/locales"

export MOZ_APP_BASENAME=Browser
export MOZ_BRANDING_DIRECTORY=${brandingDir}
export MOZ_OFFICIAL_BRANDING_DIRECTORY=${brandingDir}

ac_add_options --with-distribution-id=com.browser

export MOZ_SOURCE_CHANGESET=${changeset}
export MOZ_INCLUDE_SOURCE_INFO=1

ac_add_options --enable-application=browser

if test "$SCCACHE_GHA_ENABLED" = "true"; then
  if test -x "$(command -v sccache)"; then
    ac_add_options --with-ccache=sccache
  elif test -f "$HOME/.mozbuild/sccache/sccache"; then
    ac_add_options --with-ccache="$HOME"/.mozbuild/sccache/sccache
  fi
  mk_add_options 'export RUSTC_WRAPPER=sccache'
  mk_add_options 'export CCACHE_CPP2=yes'
fi

if test "$BROWSER_RELEASE"; then
  ac_add_options --enable-optimize
  ac_add_options --enable-release
  ac_add_options --disable-debug
  ac_add_options --disable-debug-symbols
  ac_add_options --disable-debug-js-modules
  ac_add_options --disable-tests
  ac_add_options --enable-rust-simd
  ac_add_options --disable-geckodriver
  ac_add_options --disable-rust-tests
  ac_add_options --disable-crashreporter

  if ! test "$BROWSER_DISABLE_BOOTSTRAP"; then
    ac_add_options --enable-bootstrap=-sccache
  fi

  # LTO: отключаемо, чтобы первая сборка шла быстрее и требовала меньше памяти
  if test "$BROWSER_DISABLE_LTO"; then
    ac_add_options --disable-lto
  else
    export MOZ_LTO=cross,thin
    ac_add_options --enable-lto=cross,thin
  fi

  mk_add_options MOZILLA_OFFICIAL=1
  MOZILLA_OFFICIAL=1
  export MOZILLA_OFFICIAL=1
  mk_add_options AUTOCLOBBER=1
  export AUTOCLOBBER=1
fi

# Разрешить неподписанные системные расширения (для своих встроенных модулей)
ac_add_options --with-unsigned-addon-scopes=app,system
export MOZ_REQUIRE_SIGNING=
mk_add_options MOZ_REQUIRE_SIGNING=

# Телеметрия Mozilla выключена на уровне сборки
mk_add_options MOZ_DATA_REPORTING=
mk_add_options MOZ_SERVICES_HEALTHREPORT=
mk_add_options MOZ_TELEMETRY_REPORTING=
ac_add_options MOZ_DATA_REPORTING=
ac_add_options MOZ_TELEMETRY_REPORTING=
