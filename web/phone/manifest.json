{
  "manifest_version": 2,
  "name": "Tabora Account",
  "description": "Вход в аккаунт Tabora и синхронизация в приложении для телефона. Встроен в приложение, отдельно не ставится.",
  "version": "__VERSION__",
  "browser_specific_settings": {
    "gecko": {
      "id": "account@tabora.app"
    }
  },
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": __FILL_MATCHES__,
      "js": ["assets/fill.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "__API_PATTERN__"
  ],
  "content_security_policy": "__MANIFEST_CSP__"
}
